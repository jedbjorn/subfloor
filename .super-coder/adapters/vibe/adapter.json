{
  "harness": "vibe",
  "launch": ["vibe", "--trust"],
  "surfaces": {
    "terminal": true,
    "one_shot": false,
    "browser": false,
    "sprint": false
  },
  "boot_artifact": "AGENTS.md",
  "emit": [],
  "env": {},
  "runtime_compatibility": {
    "minimum_cli_version": "2.22.0",
    "maximum_cli_version_exclusive": "2.23.0",
    "verified_cli_version": "2.22.0"
  },
  "mcp": {
    "streamable_http": {
      "supported": false,
      "reason": "the Vibe adapter has no managed streamable-HTTP MCP injection"
    }
  },
  "sandbox": { "launch_flags": ["--agent", "auto-approve"] }
}
