{
  "harness": "deepseek",
  "runtime": { "command": "dsh" },
  "surfaces": {
    "terminal": false,
    "one_shot": false,
    "browser": false,
    "sprint": false
  },
  "official_runtime": {
    "distribution": "@deepseek-ai/dsh",
    "version": "0.1.1-rc.2",
    "tag": "dsh-v0.1.1-rc.2",
    "commit": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e",
    "selected_seam": "stock-host-api",
    "feasibility_evidence": "assets/deepseek/stock-host-seam.json",
    "profile_home": "$DSH_HOME or ~/.dsh"
  },
  "runtime_compatibility": {
    "minimum_cli_version": "0.1.1",
    "maximum_cli_version_exclusive": "0.1.2",
    "verified_cli_version": "0.1.1",
    "verified_observed_version": "0.1.1-rc.2"
  },
  "interactive": {
    "kind": "local_web",
    "launch": ["dsh", "web"],
    "host": "127.0.0.1",
    "port_source": "SC_DEEPSEEK_HOST_PORT",
    "readiness_path": "/",
    "workspace_method": "workspace.create",
    "browser_open_owner": "host-dispatcher",
    "url_fallback": true
  },
  "boot_artifact": "AGENTS.md",
  "emit": [],
  "skill_dirs": [".agents/skills"],
  "env": {},
  "mcp": {
    "streamable_http": {
      "supported": false,
      "reason": "the selected stock DeepSeek Web profile exposes no managed arbitrary MCP injection surface"
    }
  },
  "conversation": {
    "selected": false,
    "legacy": true,
    "unavailable_reason": "HARNESS_OFFICIAL_HOST_ADAPTER_PENDING",
    "contract_version": 1,
    "minimum_cli_version": "0.1.0rc7",
    "maximum_cli_version_exclusive": "0.1.0rc8",
    "verified_cli_version": "0.1.0rc7",
    "driver": "deepseek-isolated-sdk-carrier",
    "session_ref": { "source": "session/start", "field": "sessionId" },
    "start": { "method": "session/start" },
    "resume": { "method": "session/start", "session_field": "sessionId" },
    "stream": { "transport": "isolated-jsonl-rpc-notifications" },
    "interrupt": { "method": "session/cancel" },
    "inspect": { "method": "session/inspect" },
    "reconcile": { "method": "session/reconcile" },
    "permission_policy": "fixed-unattended-composition",
    "execution_permissions": {
      "requirement": "worktree-command-access",
      "unrestricted_mechanism": "fixed-local-bash-and-filesystem",
      "sandbox_flag_required": false
    },
    "normalized_events": [
      "session.started",
      "run.started",
      "assistant.delta",
      "tool.started",
      "tool.completed",
      "permission.requested",
      "input.requested",
      "usage",
      "run.completed",
      "run.failed",
      "run.interrupted"
    ],
    "capabilities": {
      "exact_session_resume": true,
      "structured_streaming": true,
      "interruption": true,
      "interactive_permission_response": false,
      "server_backed": true,
      "session_inspection": true
    }
  },
  "sandbox": {}
}
