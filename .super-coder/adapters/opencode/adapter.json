{
  "harness": "opencode",
  "launch": ["opencode"],
  "surfaces": {
    "terminal": true,
    "one_shot": true,
    "browser": true,
    "sprint": true
  },
  "boot_artifact": "AGENTS.md",
  "global_pointer": ".config/opencode/AGENTS.md",
  "emit": ["opencode.json"],
  "skill_dirs": [".claude/skills", ".opencode/skills"],
  "env": { "OPENCODE_DISABLE_CLAUDE_CODE": "1" },
  "mcp": {
    "streamable_http": {
      "supported": true,
      "managed_server": {
        "name": "windows-mcp",
        "url": "http://127.0.0.1:18000/mcp",
        "merge_json": {
          "opencode.json": {
            "mcp": {
              "windows-mcp": {
                "type": "remote",
                "url": "http://127.0.0.1:18000/mcp",
                "enabled": true,
                "oauth": false
              }
            }
          }
        }
      }
    }
  },
  "model": { "file": "opencode.json", "key": "model" },
  "headless": {
    "launch": ["opencode", "run"],
    "model_flag": "--model"
  },
  "conversation": {
    "contract_version": 1,
    "minimum_cli_version": "1.18.9",
    "maximum_cli_version_exclusive": "1.19.0",
    "verified_cli_version": "1.18.9",
    "driver": "opencode-server",
    "session_ref": { "source": "session.create", "field": "id" },
    "stream": { "transport": "sse", "path": "/event" },
    "interrupt": { "method": "POST", "path": "/session/{session_ref}/abort" },
    "inspect": { "method": "GET", "path": "/session/{session_ref}" },
    "permission_policy": "opencode-config-and-permission-events",
    "execution_permissions": {
      "requirement": "worktree-command-access",
      "unrestricted_mechanism": "session-permission-rules",
      "sandbox_flag_required": false
    },
    "normalized_events": [
      "session.started",
      "run.started",
      "assistant.delta",
      "tool.started",
      "tool.completed",
      "permission.requested",
      "input.requested",
      "usage",
      "run.completed",
      "run.failed",
      "run.interrupted"
    ],
    "capabilities": {
      "exact_session_resume": true,
      "structured_streaming": true,
      "interruption": true,
      "interactive_permission_response": true,
      "server_backed": true,
      "session_inspection": true
    }
  },
  "sandbox": {
    "merge_json": {
      "opencode.json": {
        "permission": { "bash": "allow" }
      }
    }
  }
}
